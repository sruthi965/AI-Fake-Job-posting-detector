# Copy to .env and edit. Never commit the real .env file.

APP_ENV=development
# Required in production: a random string of 32+ characters, e.g.  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
ACCESS_TOKEN_MINUTES=60

# SQLite works out of the box for local use. Use MySQL for deployment.
DATABASE_URL=sqlite:///./jobguard.db
# DATABASE_URL=mysql://jobguard:your-password@localhost:3306/jobguard

# Only needed when the frontend is served from a different origin (comma separated)
CORS_ORIGINS=

# LLM explanations: none | openai | azure. With "none" (or on any error) a template explanation is used.
LLM_PROVIDER=none
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# Azure OpenAI
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-06-01
LLM_TIMEOUT_SECONDS=30
